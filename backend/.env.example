# =========================================================================
# Multi-Tenant AI RAG SaaS Platform - Environment Configuration Template
# =========================================================================
# Rename this file to '.env' and populate the values below.
# DO NOT commit real secrets or credentials to version control!

# 1. Database Configuration
# Prisma PostgreSQL connection string. Ensure the DB user has read/write permissions.
# Format: postgresql://[user]:[password]@[host]:[port]/[database]?schema=public
DATABASE_URL="postgresql://postgres:yourpassword@localhost:5432/multitenant_rag?schema=public"

# 2. Authentication Configuration
# A secure, long, random string used to sign and verify JSON Web Tokens (JWT).
# Minimum length: 8 characters. For production, use a strong 256-bit key.
JWT_SECRET="generate_a_secure_random_key_here_at_least_32_chars"

# 3. LLM API Configuration
# Your Gemini Developer API Key. Obtain this from Google AI Studio.
# Required to compute embeddings and generate context-grounded completions.
GEMINI_API_KEY="AIzaSyYourGeminiApiKeyHere"

# 4. Server Configuration
# The port number on which the Express backend will listen.
PORT=5000

# 5. Environment Type
# The current execution environment. Choices: development, production, test.
NODE_ENV="development"

# 6. Frontend Origin URL
# The origin domain allowed to perform requests to this API (CORS origin).
# For local development: http://localhost:5173
# For production: https://your-frontend-vercel-app.vercel.app
FRONTEND_URL="http://localhost:5173"
